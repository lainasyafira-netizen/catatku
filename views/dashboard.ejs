<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/output.css" rel="stylesheet">
    <!-- Chart.js for Doughnut Chart -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 flex flex-col justify-between">
    <div>
        <!-- Navbar -->
        <nav class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center space-x-8">
                        <span class="text-2xl font-bold text-blue-600">CatatKu</span>
                        <div class="hidden sm:flex space-x-4">
                            <a href="/dashboard" class="px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-md">
                                Dashboard
                            </a>
                            <a href="/transactions" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Transaksi
                            </a>
                            <a href="/budgets" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Anggaran
                            </a>
                            <a href="/categories" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Kategori
                            </a>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <span class="text-sm font-medium text-gray-700 hidden sm:inline">Halo, <%= user ? user.name : 'Pengguna' %></span>
                        <form action="/auth/logout" method="POST" class="inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="px-4 py-2 text-sm font-medium text-red-600 hover:text-red-800 hover:bg-red-50 rounded-md transition border border-red-200">
                                Keluar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            
            <div class="mb-8">
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Selamat Datang, <%= user ? user.name.split(' ')[0] : 'Pengguna' %>!</h1>
                <p class="text-gray-600 mt-1">Berikut adalah ringkasan keuangan Anda saat ini.</p>
            </div>

            <!-- Budget Alerts Area -->
            <% if (budgetAlerts && budgetAlerts.length > 0) { %>
                <div class="mb-6 space-y-3">
                    <% budgetAlerts.forEach(alert => { %>
                        <% if (alert.type === 'danger') { %>
                            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md shadow-sm flex items-start">
                                <svg class="h-5 w-5 text-red-500 mr-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                                <div>
                                    <h3 class="text-sm font-bold text-red-800">Peringatan Kritis</h3>
                                    <p class="text-sm text-red-700 mt-1"><%= alert.message %></p>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded-md shadow-sm flex items-start">
                                <svg class="h-5 w-5 text-yellow-500 mr-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                                <div>
                                    <h3 class="text-sm font-bold text-yellow-800">Perhatian</h3>
                                    <p class="text-sm text-yellow-700 mt-1"><%= alert.message %></p>
                                </div>
                            </div>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>

            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <!-- Saldo Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-center transform transition duration-300 hover:scale-105 hover:shadow-md">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Saldo Saat Ini</h2>
                    <p class="text-3xl font-extrabold text-blue-600">
                        Rp <%= new Intl.NumberFormat('id-ID').format(currentBalance) %>
                    </p>
                    <p class="text-xs text-gray-400 mt-2">Dihitung dari total keseluruhan transaksi</p>
                </div>

                <!-- Pemasukan Bulan Ini Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-center transform transition duration-300 hover:scale-105 hover:shadow-md">
                    <div class="flex items-center justify-between mb-1">
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Pemasukan Bulan Ini</h2>
                        <span class="p-1.5 bg-green-100 text-green-600 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
                        </span>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-800">
                        Rp <%= new Intl.NumberFormat('id-ID').format(monthIncome) %>
                    </p>
                </div>

                <!-- Pengeluaran Bulan Ini Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-center transform transition duration-300 hover:scale-105 hover:shadow-md">
                    <div class="flex items-center justify-between mb-1">
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Pengeluaran Bulan Ini</h2>
                        <span class="p-1.5 bg-red-100 text-red-600 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                        </span>
                    </div>
                    <p class="text-3xl font-extrabold text-gray-800">
                        Rp <%= new Intl.NumberFormat('id-ID').format(monthExpense) %>
                    </p>
                </div>
            </div>

            <!-- Chart Section -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8 max-w-3xl mx-auto">
                <h2 class="text-xl font-bold text-gray-900 mb-6 text-center">Pengeluaran per Kategori (Bulan Ini)</h2>
                
                <div class="relative h-64 w-full flex justify-center">
                    <canvas id="expenseChart"></canvas>
                </div>
                
                <div id="noDataMessage" class="hidden text-center text-gray-500 mt-4">
                    Belum ada data pengeluaran bulan ini.
                </div>
            </div>

        </main>
    </div>

    <!-- Chart Setup Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const labels = <%- chartLabels %>;
            const data = <%- chartData %>;
            
            if (data.length === 0) {
                document.getElementById('expenseChart').style.display = 'none';
                document.getElementById('noDataMessage').classList.remove('hidden');
                return;
            }

            const ctx = document.getElementById('expenseChart').getContext('2d');
            
            // Modern, vibrant color palette
            const backgroundColors = [
                'rgba(59, 130, 246, 0.8)',   // blue-500
                'rgba(239, 68, 68, 0.8)',    // red-500
                'rgba(16, 185, 129, 0.8)',   // emerald-500
                'rgba(245, 158, 11, 0.8)',   // amber-500
                'rgba(139, 92, 246, 0.8)',   // violet-500
                'rgba(236, 72, 153, 0.8)',   // pink-500
                'rgba(14, 165, 233, 0.8)',   // sky-500
                'rgba(249, 115, 22, 0.8)',   // orange-500
            ];

            const borderColors = [
                'rgba(59, 130, 246, 1)',
                'rgba(239, 68, 68, 1)',
                'rgba(16, 185, 129, 1)',
                'rgba(245, 158, 11, 1)',
                'rgba(139, 92, 246, 1)',
                'rgba(236, 72, 153, 1)',
                'rgba(14, 165, 233, 1)',
                'rgba(249, 115, 22, 1)',
            ];

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: backgroundColors.slice(0, data.length),
                        borderColor: borderColors.slice(0, data.length),
                        borderWidth: 2,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                font: {
                                    family: "'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif",
                                    size: 12
                                },
                                padding: 20
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed !== null) {
                                        label += new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(context.parsed);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    cutout: '65%',
                    animation: {
                        animateScale: true,
                        animateRotate: true
                    }
                }
            });
        });
    </script>
</body>
</html>
