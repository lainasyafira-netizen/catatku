<%- include('partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">
    
    <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Selamat Datang, <%= user ? user.name.split(' ')[0] : 'Pengguna' %>! 👋
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Berikut adalah ringkasan kesehatan finansial Anda saat ini.</p>
    </div>

    <!-- Budget Alerts Area -->
    <% if (budgetAlerts && budgetAlerts.length > 0) { %>
        <div class="mb-8 space-y-3">
            <% budgetAlerts.forEach(alert => { %>
                <% if (alert.type === 'danger') { %>
                    <div class="bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 p-4 rounded-2xl shadow-sm flex items-start space-x-3">
                        <svg class="h-5 w-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div>
                            <h3 class="text-sm font-bold text-red-800 dark:text-red-300">Peringatan Kritis</h3>
                            <p class="text-sm text-red-700 dark:text-red-400 mt-0.5"><%= alert.message %></p>
                        </div>
                    </div>
                <% } else { %>
                    <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 p-4 rounded-2xl shadow-sm flex items-start space-x-3">
                        <svg class="h-5 w-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div>
                            <h3 class="text-sm font-bold text-amber-800 dark:text-amber-300">Perhatian</h3>
                            <p class="text-sm text-amber-700 dark:text-amber-400 mt-0.5"><%= alert.message %></p>
                        </div>
                    </div>
                <% } %>
            <% }); %>
        </div>
    <% } %>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Saldo Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/60 p-6 flex flex-col justify-between transition-transform duration-200 hover:-translate-y-1">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Saldo saat ini</span>
                <h3 class="text-3xl font-extrabold text-blue-600 dark:text-blue-400 mt-2">
                    Rp <%= new Intl.NumberFormat('id-ID').format(currentBalance) %>
                </h3>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-4">Akumulasi total seluruh pemasukan dikurangi pengeluaran</p>
        </div>

        <!-- Pemasukan Bulan Ini Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/60 p-6 flex flex-col justify-between transition-transform duration-200 hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Pemasukan Bulan Ini</span>
                <span class="p-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 rounded-xl">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
                </span>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2">
                Rp <%= new Intl.NumberFormat('id-ID').format(monthIncome) %>
            </h3>
        </div>

        <!-- Pengeluaran Bulan Ini Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/60 p-6 flex flex-col justify-between transition-transform duration-200 hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Pengeluaran Bulan Ini</span>
                <span class="p-2 bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-xl">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                </span>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2">
                Rp <%= new Intl.NumberFormat('id-ID').format(monthExpense) %>
            </h3>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/60 p-6 max-w-3xl mx-auto">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 text-center">Pengeluaran per Kategori (Bulan Ini)</h2>
        
        <div class="relative h-64 w-full flex justify-center">
            <canvas id="expenseChart"></canvas>
        </div>
        
        <div id="noDataMessage" class="hidden text-center text-slate-500 dark:text-slate-400 mt-4 text-sm">
            Belum ada data pengeluaran di bulan ini.
        </div>
    </div>

</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const labels = <%- chartLabels %>;
        const data = <%- chartData %>;
        
        if (data.length === 0) {
            document.getElementById('expenseChart').style.display = 'none';
            document.getElementById('noDataMessage').classList.remove('hidden');
            return;
        }

        const isDark = document.documentElement.classList.contains('dark');
        const legendColor = isDark ? '#94a3b8' : '#475569';

        const ctx = document.getElementById('expenseChart').getContext('2d');
        
        const backgroundColors = [
            'rgba(59, 130, 246, 0.85)',
            'rgba(239, 68, 68, 0.85)',
            'rgba(16, 185, 129, 0.85)',
            'rgba(245, 158, 11, 0.85)',
            'rgba(139, 92, 246, 0.85)',
            'rgba(236, 72, 153, 0.85)',
            'rgba(14, 165, 233, 0.85)',
            'rgba(249, 115, 22, 0.85)',
        ];

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors.slice(0, data.length),
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            color: legendColor,
                            font: { family: "'Inter', sans-serif", size: 12 },
                            padding: 16
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                if (label) label += ': ';
                                if (context.parsed !== null) {
                                    label += new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(context.parsed);
                                }
                                return label;
                            }
                        }
                    }
                },
                cutout: '68%',
            }
        });
    });
</script>

<%- include('partials/footer') %>
