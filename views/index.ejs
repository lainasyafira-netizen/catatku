<%- include('partials/header') %>

<!-- Header Landing -->
<header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md sticky top-0 z-40 border-b border-slate-200 dark:border-slate-700/60 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-2 text-2xl font-extrabold text-blue-600 dark:text-blue-400 tracking-tight">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>CatatKu</span>
        </div>

        <div class="flex items-center space-x-3">
            <!-- Theme Toggle -->
            <button type="button" onclick="toggleDarkMode()" aria-label="Toggle Dark Mode" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors">
                <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg class="w-5 h-5 block dark:hidden text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
            </button>

            <% if (user) { %>
                <a href="/dashboard" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition">
                    Dashboard
                </a>
            <% } else { %>
                <a href="/auth/login" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400 transition">
                    Masuk
                </a>
                <a href="/auth/register" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition">
                    Daftar
                </a>
            <% } %>
        </div>
    </div>
</header>

<!-- Hero Section -->
<main class="flex-grow flex flex-col justify-center max-w-5xl mx-auto px-4 py-16 text-center">
    <div class="inline-flex items-center space-x-2 px-3 py-1 bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/40 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold mb-6 mx-auto">
        <span>✨ Kelola Keuangan Mahasiswa Lebih Cerdas</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
        Catat Pemasukan & Pengeluaran <br class="hidden sm:inline">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">Dengan Mudah & Akurat</span>
    </h1>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        CatatKu membantu mahasiswa mencatat transaksi bulanan, mengatur batasan anggaran per kategori, dan memvisualisasikan laporan keuangan secara real-time.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
        <% if (user) { %>
            <a href="/dashboard" class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 transition duration-150 transform hover:-translate-y-0.5">
                Buka Dashboard Anda
            </a>
        <% } else { %>
            <a href="/auth/register" class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 transition duration-150 transform hover:-translate-y-0.5">
                Mulai Sekarang (Gratis)
            </a>
            <a href="/auth/login" class="px-8 py-3.5 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60 shadow-sm transition">
                Sudah Punya Akun
            </a>
        <% } %>
    </div>

    <!-- Features Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700/60 shadow-sm">
            <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center mb-4 font-bold">
                💳
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Pencatatan Cepat</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">Catat pemasukan dan pengeluaran harian lengkap dengan kategori dan catatan khusus.</p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700/60 shadow-sm">
            <div class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-center mb-4 font-bold">
                🎯
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Target Anggaran</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">Pasang batas pengeluaran per kategori dan dapatkan peringatan otomatis jika melampaui 80%.</p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700/60 shadow-sm">
            <div class="w-10 h-10 bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 rounded-xl flex items-center justify-center mb-4 font-bold">
                📊
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Grafik & Laporan</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">Visualisasi tren pengeluaran bulanan dan pie chart interaktif berbasis Chart.js.</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
