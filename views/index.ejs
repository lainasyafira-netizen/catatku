<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col justify-between">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="text-2xl font-bold text-blue-600">CatatKu</div>
            <div class="space-x-3">
                <% if (user) { %>
                    <a href="/dashboard" class="px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition">
                        Dashboard
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="px-4 py-2 text-blue-600 font-medium hover:text-blue-800 transition">
                        Masuk
                    </a>
                    <a href="/auth/register" class="px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition">
                        Daftar
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-4xl mx-auto px-4 py-16 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
            Kelola Keuangan Mahasiswa Lebih Cerdas
        </h1>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
            CatatKu membantu mahasiswa mencatat pemasukan, pengeluaran, serta mengatur anggaran bulanan dengan mudah dan transparan.
        </p>
        <div class="flex justify-center space-x-4">
            <% if (user) { %>
                <a href="/dashboard" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition">
                    Buka Dashboard
                </a>
            <% } else { %>
                <a href="/auth/register" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition">
                    Mulai Sekarang (Gratis)
                </a>
                <a href="/auth/login" class="px-6 py-3 bg-gray-200 text-gray-800 font-semibold rounded-lg hover:bg-gray-300 transition">
                    Sudah Punya Akun
                </a>
            <% } %>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-6 text-center text-sm text-gray-500">
        &copy; <%= new Date().getFullYear() %> CatatKu. All rights reserved.
    </footer>
</body>
</html>
