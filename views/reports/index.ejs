<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/output.css" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 flex flex-col justify-between">
    <div>
        <!-- Navbar -->
        <nav class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center space-x-8">
                        <span class="text-2xl font-bold text-blue-600">CatatKu</span>
                        <div class="hidden sm:flex space-x-4">
                            <a href="/dashboard" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Dashboard
                            </a>
                            <a href="/transactions" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Transaksi
                            </a>
                            <a href="/budgets" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Anggaran
                            </a>
                            <a href="/reports" class="px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-md">
                                Laporan
                            </a>
                            <a href="/categories" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 rounded-md">
                                Kategori
                            </a>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <span class="text-sm font-medium text-gray-700 hidden sm:inline">Halo, <%= user ? user.name : 'Pengguna' %></span>
                        <form action="/auth/logout" method="POST" class="inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="px-4 py-2 text-sm font-medium text-red-600 hover:text-red-800 hover:bg-red-50 rounded-md transition border border-red-200">
                                Keluar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="mb-8">
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Laporan Keuangan</h1>
                <p class="text-gray-600 mt-1">Analisis pengeluaran dan pemasukan Anda melalui grafik yang mudah dipahami.</p>
            </div>

            <!-- Charts Section (Grid) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                
                <!-- 6 Months Trend (Bar Chart) -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
                    <h2 class="text-lg font-bold text-gray-800 mb-6 text-center">Tren 6 Bulan Terakhir</h2>
                    <div class="relative flex-grow min-h-[300px] w-full flex justify-center">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>

                <!-- Expense Pie Chart by Month -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-lg font-bold text-gray-800">Pengeluaran per Kategori</h2>
                        
                        <!-- Mini filter for pie chart -->
                        <form action="/reports" method="GET" class="flex space-x-2">
                            <!-- Preserve other filters as hidden -->
                            <input type="hidden" name="startDate" value="<%= startDate %>">
                            <input type="hidden" name="endDate" value="<%= endDate %>">
                            <input type="hidden" name="categoryId" value="<%= selectedCategory %>">
                            
                            <select name="month" class="px-2 py-1 text-xs border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500">
                                <% const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des']; %>
                                <% months.forEach((m, idx) => { %>
                                    <option value="<%= idx + 1 %>" <%= currentMonth === (idx + 1) ? 'selected' : '' %>><%= m %></option>
                                <% }); %>
                            </select>
                            <select name="year" class="px-2 py-1 text-xs border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500">
                                <% const startYear = new Date().getFullYear() - 2; %>
                                <% for(let y = startYear; y <= startYear + 4; y++) { %>
                                    <option value="<%= y %>" <%= currentYear === y ? 'selected' : '' %>><%= y %></option>
                                <% } %>
                            </select>
                            <button type="submit" class="px-2 py-1 bg-gray-100 border border-gray-300 rounded-md text-xs font-medium hover:bg-gray-200">
                                Go
                            </button>
                        </form>
                    </div>
                    
                    <div class="relative flex-grow min-h-[300px] w-full flex justify-center">
                        <canvas id="pieChart"></canvas>
                    </div>
                    <div id="noPieDataMsg" class="hidden text-center text-gray-500 mt-4 text-sm">
                        Belum ada data pengeluaran di bulan ini.
                    </div>
                </div>
            </div>

            <!-- Advanced Filter for Transactions -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
                <h3 class="text-md font-bold text-gray-800 mb-4">Filter Riwayat Transaksi</h3>
                <form action="/reports" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <!-- Preserve month/year filters -->
                    <input type="hidden" name="month" value="<%= currentMonth %>">
                    <input type="hidden" name="year" value="<%= currentYear %>">
                    
                    <div>
                        <label for="startDate" class="block text-xs font-medium text-gray-700 mb-1">Dari Tanggal</label>
                        <input type="date" id="startDate" name="startDate" value="<%= startDate %>" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="endDate" class="block text-xs font-medium text-gray-700 mb-1">Sampai Tanggal</label>
                        <input type="date" id="endDate" name="endDate" value="<%= endDate %>" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="categoryId" class="block text-xs font-medium text-gray-700 mb-1">Kategori</label>
                        <select id="categoryId" name="categoryId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="ALL">Semua Kategori</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md text-sm transition">
                            Terapkan Filter
                        </button>
                        <a href="/reports" class="block text-center mt-2 text-xs text-gray-500 hover:text-gray-700 underline">Reset Filter</a>
                    </div>
                </form>
            </div>

            <!-- Transaction History Table -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-md font-bold text-gray-800">Riwayat Transaksi</h3>
                </div>
                
                <% if (historyTransactions.length === 0) { %>
                    <div class="text-center py-8 text-gray-500 text-sm">
                        Tidak ada transaksi yang cocok dengan filter yang dipilih.
                    </div>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipe</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kategori</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Catatan</th>
                                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Jumlah</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% historyTransactions.forEach(t => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500">
                                            <%= new Date(t.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap">
                                            <% if (t.type === 'INCOME') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Pemasukan</span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Pengeluaran</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                                            <%= t.category.name %>
                                        </td>
                                        <td class="px-6 py-3 text-sm text-gray-500 max-w-xs truncate">
                                            <%= t.description || '-' %>
                                        </td>
                                        <td class="px-6 py-3 whitespace-nowrap text-sm font-bold text-right <%= t.type === 'INCOME' ? 'text-green-600' : 'text-red-600' %>">
                                            <%= t.type === 'INCOME' ? '+' : '-' %> Rp <%= new Intl.NumberFormat('id-ID').format(t.amount) %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <!-- Chart Configuration -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Setup Formatters
            const idrFormatter = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' });

            // 1. Trend Chart (Bar Chart)
            const trendCtx = document.getElementById('trendChart').getContext('2d');
            const trendLabels = <%- trendLabels %>;
            const incomeData = <%- incomeData %>;
            const expenseData = <%- expenseData %>;

            new Chart(trendCtx, {
                type: 'bar',
                data: {
                    labels: trendLabels,
                    datasets: [
                        {
                            label: 'Pemasukan',
                            data: incomeData,
                            backgroundColor: 'rgba(16, 185, 129, 0.85)', // emerald-500
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Pengeluaran',
                            data: expenseData,
                            backgroundColor: 'rgba(239, 68, 68, 0.85)', // red-500
                            borderColor: 'rgba(239, 68, 68, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + idrFormatter.format(context.parsed.y);
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return 'Rp ' + (value / 1000000) + ' Juta';
                                    if (value >= 1000) return 'Rp ' + (value / 1000) + ' Ribu';
                                    return 'Rp ' + value;
                                }
                            }
                        }
                    }
                }
            });

            // 2. Pie Chart
            const pieCtx = document.getElementById('pieChart').getContext('2d');
            const pieLabels = <%- pieLabels %>;
            const pieData = <%- pieData %>;

            if (pieData.length === 0) {
                document.getElementById('pieChart').style.display = 'none';
                document.getElementById('noPieDataMsg').classList.remove('hidden');
            } else {
                const colors = [
                    'rgba(59, 130, 246, 0.8)', 'rgba(239, 68, 68, 0.8)', 'rgba(16, 185, 129, 0.8)',
                    'rgba(245, 158, 11, 0.8)', 'rgba(139, 92, 246, 0.8)', 'rgba(236, 72, 153, 0.8)',
                    'rgba(14, 165, 233, 0.8)', 'rgba(249, 115, 22, 0.8)'
                ];
                const borderColors = colors.map(c => c.replace('0.8', '1'));

                new Chart(pieCtx, {
                    type: 'pie', // specifically requested pie chart
                    data: {
                        labels: pieLabels,
                        datasets: [{
                            data: pieData,
                            backgroundColor: colors,
                            borderColor: borderColors,
                            borderWidth: 1,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { font: { size: 11 }, boxWidth: 12 }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + idrFormatter.format(context.parsed);
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
